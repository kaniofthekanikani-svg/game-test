rasutoday = None

def daycheck():
    global rasutoday, deiri

    now = datetime.now(timezone.utc) + timedelta(hours=9)

    if rasutoday != now.date():
        deiri = []
        rasutoday = now.date()

    return now.hour >= okiro


# ===== 起動時チェック =====
@client.event

async def on_ready():
    print("bot起動")
    
    # 許可されてないサーバーから抜ける
    for guild in client.guilds:
        if str(guild.id) not in ALLOWED_GUILDS:
            await guild.leave()
            print(f"leave : {guild.id} : {guild.name}")
        else:
            print(f"allow : {guild.id} : {guild.name}")

# ===== 新規参加時チェック =====
@client.event
async def on_guild_join(guild):
    if str(guild.id) not in ALLOWED_GUILDS:
        await guild.leave()
        print(f"leave : {guild.id} : {guild.name}")
    else:
        print(f"allow : {guild.id} : {guild.name}")









